# ---- Discord (required) ----
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here
# Right-click the target channel in Discord (Developer Mode on) -> Copy Channel ID
DISCORD_CHANNEL_ID=123456789012345678

# ---- Coinalyze (optional but recommended: primary source) ----
# https://coinalyze.net/  -> sign in -> API page -> generate key
# NOTE: this is a key string, NOT the docs URL.
# Leave blank to run on Binance only.
COINALYZE_API_KEY=

# ---- Tuning (optional) ----
POST_INTERVAL_MINUTES=10
TOP_N=20
# Table layout: mobile (fits a phone) or wide (adds a SHORT column, desktop)
LAYOUT=mobile
